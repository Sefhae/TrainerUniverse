# Supabase project URL + anon/publishable key (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://yoursupabaseurl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=yoursupabasepublishablekey

# Service-role key — server-only, NEVER expose to the browser. Required for admin
# routes (managing other users). Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=yoursupabaseservicerolekey
